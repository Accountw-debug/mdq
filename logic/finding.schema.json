{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdq.local/schemas/finding.schema.json",
  "title": "MDQ Finding",
  "description": "Ein Finding ist eine Feststellung einer Regel zu einem Geschäftspartner oder Beleg(paar). Zentrales Objekt der Lösung.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id", "run_id", "rule_id", "rule_version", "engine_version", "pack_version",
    "side", "category", "severity", "damage_class", "tier", "action_type", "title",
    "entity", "current", "why", "if_wrong", "remediation", "status", "data_as_of", "created_at"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "description": "Deterministisch aus rule_id + entity + current gebildet (z. B. sha1-Präfix), damit gleiche Findings über Läufe wiedererkannt werden.",
      "pattern": "^F-[a-f0-9]{12}$"
    },
    "run_id": { "type": "string", "minLength": 1 },
    "rule_id": {
      "type": "string",
      "pattern": "^(AR|AP|CROSS)-(COM|VAL|CON|HYG|RSK|DUP|LEA)-[0-9]{3}$",
      "description": "Seite-Kategorie-Nummer, z. B. AR-VAL-001"
    },
    "rule_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "engine_version": { "type": "string" },
    "pack_version": { "type": "string", "description": "Version des Regelpakets/Wörterbuchs" },
    "side": { "type": "string", "enum": ["AR", "AP", "CROSS"] },
    "category": {
      "type": "string",
      "enum": ["completeness", "validity", "consistency", "hygiene", "risk", "duplicate", "leakage"]
    },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "damage_class": {
      "type": "integer", "enum": [1, 2, 3],
      "description": "1 = Geldwirkung bei Fehlkorrektur (Bankdaten), 2 = steuerlich/vertraglich, 3 = reversibel"
    },
    "tier": {
      "type": "string", "enum": ["A", "B", "C", "decision"],
      "description": "A Soll (≥99 %), B Vorschlag (≥90 %), C Hinweis, decision = Entscheidung des Kunden"
    },
    "action_type": { "type": "string", "enum": ["mass_change", "review", "decision", "process"] },
    "title": {
      "type": "string", "minLength": 1, "maxLength": 120,
      "description": "Kurzüberschrift für Listen. Pflicht – die Engine füllt sie aus dem Regelkopf."
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bp_key", "role"],
      "properties": {
        "bp_key": { "type": "string", "pattern": "^[CV]:[A-Za-z0-9]+$", "description": "C:<KUNNR> oder V:<LIFNR>" },
        "role": { "type": "string", "enum": ["CUSTOMER", "VENDOR"] },
        "company_code": { "type": ["string", "null"] },
        "display_name": { "type": ["string", "null"] },
        "related_bp_keys": {
          "type": "array", "items": { "type": "string" },
          "description": "Weitere BPs, z. B. Dubletten-Cluster oder Gegenpartei bei CROSS"
        },
        "documents": {
          "type": "array",
          "description": "Beteiligte Belege (z. B. Doppelzahlungspaar)",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["company_code", "fiscal_year", "document_no"],
            "properties": {
              "company_code": { "type": "string" },
              "fiscal_year": { "type": "string" },
              "document_no": { "type": "string" },
              "line_item": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "relevance": {
      "type": "object",
      "description": "Gewichtung: offene Posten und 12-Monats-Volumen des BP, in der Hauswährung des Buchungskreises",
      "additionalProperties": false,
      "required": ["currency"],
      "properties": {
        "open_items": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$" },
        "volume_12m": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "Hauswährung – Beträge sind nicht umgerechnet" },
        "last_activity_on": { "type": ["string", "null"], "format": "date" }
      }
    },
    "current": {
      "type": "object",
      "description": "Ist-Zustand wie im Quellsystem",
      "additionalProperties": false,
      "required": ["source_table", "source_field", "value"],
      "properties": {
        "source_table": { "type": "string" },
        "source_field": { "type": "string" },
        "value": { "type": ["string", "null"] },
        "display": { "type": ["string", "null"], "description": "Lesbare Darstellung, z. B. decodierte Zahlungsbedingung" }
      }
    },
    "proposed": {
      "type": ["object", "null"],
      "description": "Soll-Wert. null bei Stufe C/decision ohne Vorschlag.",
      "additionalProperties": false,
      "required": ["value", "source_summary"],
      "properties": {
        "value": { "type": ["string", "null"] },
        "display": { "type": ["string", "null"] },
        "source_summary": { "type": "string", "description": "Quellenlage in Klartext, z. B. 'bestätigt durch VIES und Dublette C:0000100987'" },
        "options": {
          "type": "array",
          "description": "Bei decision: aufbereitete Optionen",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["label", "consequence"],
            "properties": { "label": { "type": "string" }, "consequence": { "type": "string" } }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_type", "reference", "value", "agrees"],
        "properties": {
          "source_type": {
            "type": "string",
            "enum": ["deterministic", "vies", "iban_checksum", "duplicate_record", "invoice", "bank_statement",
                     "payment_run", "change_document", "statistics", "model", "external_register", "postal_code_list", "policy"]
          },
          "reference": { "type": "string", "description": "Belegnummer, BP-Schlüssel, Abfrage-ID, Datei" },
          "value": { "type": ["string", "null"] },
          "observed_at": { "type": ["string", "null"], "format": "date" },
          "agrees": { "type": "boolean", "description": "true = stützt das Soll, false = widerspricht" },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "impact_eur": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["amount", "currency", "formula"],
      "properties": {
        "amount": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$", "description": "Als String mit 2 Dezimalen – nie float" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "formula": { "type": "string", "description": "Offengelegte Rechnung, z. B. '32000.00 × 2 % = 640.00'" },
        "netted_against": { "type": ["string", "null"], "description": "Gutschriften/Stornos, die abgezogen wurden" }
      }
    },
    "why": { "type": "string", "minLength": 10, "description": "Klartext: warum ist das ein Problem, was passiert, wenn es nicht behoben wird" },
    "if_wrong": { "type": "string", "minLength": 5, "description": "Klartext: was passiert, wenn der Vorschlag falsch übernommen wird" },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sap_transaction", "mass_change_eligible"],
      "properties": {
        "sap_transaction": { "type": "string", "description": "z. B. XD02, XK02, FB05, XD05, XD06" },
        "path": { "type": ["string", "null"], "description": "Reiter/Feld, z. B. 'Steuerung → USt-IdNr.'" },
        "field": { "type": ["string", "null"] },
        "mass_change_eligible": { "type": "boolean" },
        "steps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "related_finding_ids": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["open", "in_progress", "done", "accepted_risk", "rejected"] },
    "decision": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["by", "at", "reason"],
      "properties": {
        "by": { "type": "string" },
        "at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string" },
        "reason_code": { "type": ["string", "null"], "description": "z. B. intentionally_separate, data_correct, not_relevant" },
        "assigned_to": { "type": "string", "description": "Bearbeiter, dem der Fall nach der Entscheidung zugewiesen ist" }
      }
    },
    "data_as_of": { "type": "string", "format": "date" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "description": "Schadensklasse 1 darf nie Stufe A sein",
      "if": { "properties": { "damage_class": { "const": 1 } } },
      "then": { "properties": { "tier": { "enum": ["B", "C", "decision"] } } }
    },
    {
      "description": "Stufe A und B brauchen ein Soll",
      "if": { "properties": { "tier": { "enum": ["A", "B"] } } },
      "then": { "required": ["proposed"], "properties": { "proposed": { "type": "object" } } }
    },
    {
      "description": "mass_change nur bei Stufe A",
      "if": { "properties": { "action_type": { "const": "mass_change" } } },
      "then": { "properties": { "tier": { "const": "A" } } }
    }
  ]
}
